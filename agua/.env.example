# Copie para ".env" (na pasta do projeto, ao lado do pom.xml) e ajuste.
# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agua_system
DB_USER=postgres
DB_PASSWORD=a_sua_senha_do_postgres

# ---- Aplicação ----
PORT=8080
APP_TIMEZONE=Africa/Maputo
SESSION_TIMEOUT=12h
# true quando o sistema estiver em HTTPS (obrigatório em produção)
COOKIE_SECURE=false
# Origens extra autorizadas (ex.: https://agua.minhaempresa.co.mz)
ALLOWED_ORIGINS=

# ---- Suporte (aparece por baixo do login e no PDF de registo) ----
SUPPORT_PHONE=861544303
SUPPORT_NAME=Gestora Paula Zacarias
# true = empresas registadas no login ficam logo ativas; false = aguardam aprovação do administrador
AUTO_APPROVE_COMPANIES=false

# ---- Email (código de recuperação de senha). Sem MAIL_HOST, os pedidos vão para o administrador. ----
# Exemplo Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=conta@gmail.com, MAIL_PASSWORD=senha_de_aplicacao
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# SÓ PARA TESTES: mostra o código de recuperação no ecrã
DEV_SHOW_RESET_CODE=false

# ---- Mensagens WhatsApp / SMS (planos Standard e Enterprise) ----
# Sem nada configurado, as mensagens abrem no WhatsApp/SMS do telemóvel do operador (sem custos).
# Gateway de SMS da plataforma: recebe POST JSON {"from","to","message"} com "Authorization: Bearer <token>".
# (Cada empresa pode indicar o seu próprio gateway em Empresa e recibo → Mensagens.)
SMS_API_URL=
SMS_API_TOKEN=
# WhatsApp Cloud API (Meta). O "Phone number ID" e o token são de cada empresa (Empresa e recibo → Mensagens).
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
